# Class Mate Environment Configuration

# Server Port (assigned by host or default 5000)
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pocketmentor?retryWrites=true&w=majority

# JWT Session Secret
JWT_SECRET=your_jwt_secret_key_here

# (Optional) Google Gemini API Key for live AI generation
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Allowed CORS Origins (comma-separated)
CORS_ORIGIN=*
