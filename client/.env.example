# Class Mate Frontend Environment Variables
# -------------------------------------------------------------
# For local development:
# Leave this blank or do not create a .env file.
# The Vite dev server will automatically proxy /api requests to http://127.0.0.1:5000.
#
# For production deployment on Vercel:
# Set VITE_API_URL in your Vercel Project Settings > Environment Variables:
# VITE_API_URL=https://classmate-api-ti1u.onrender.com
# -------------------------------------------------------------
VITE_API_URL=https://classmate-api-ti1u.onrender.com
